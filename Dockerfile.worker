# Lyrixis upload worker (BullMQ queue "track-processing").
# Long-running Node process + ffmpeg. NOT for Vercel; deploy on Railway (or any Docker host).
# See docs/WORKER_HOSTING.md.
FROM node:22-bookworm-slim

# ffmpeg normalizes uploads to 16 kHz mono WAV (workers/pipeline.ts).
RUN apt-get update \
  && apt-get install -y --no-install-recommends ffmpeg ca-certificates \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json package-lock.json ./
# Dev deps are needed for the esbuild step (esbuild ships with tsx).
RUN npm ci --include=dev --no-audit --no-fund

COPY tsconfig.json ./
COPY workers ./workers
COPY lib ./lib
COPY providers ./providers
COPY services ./services
COPY types ./types

# Bundle to one ESM file. Running workers/index.ts through tsx in CJS mode
# crashes on music-metadata -> file-type (ESM-only, "import" export only).
RUN npm run worker:build \
  && npm prune --omit=dev --no-audit --no-fund

ENV NODE_ENV=production
USER node
CMD ["node", "dist/worker.mjs"]
